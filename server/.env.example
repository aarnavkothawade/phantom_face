# PrivacyShield Proxy Server Environment Variables
PORT=3001

# Primary Open-Weight VLM Provider (Recommended for SIH Hackathon Compliance)
# Supported models: qwen/qwen-2-vl-72b-instruct, mistralai/pixtral-12b, meta-llama/llama-3.2-11b-vision-instruct
OPENROUTER_API_KEY=
VLM_MODEL=qwen/qwen-2-vl-72b-instruct

# Alternative Open-Weight Providers
TOGETHER_API_KEY=
GROQ_API_KEY=

# Fallback Closed-Weight Providers (Flagged as non-open in telemetry/README)
GEMINI_API_KEY=
OPENAI_API_KEY=
